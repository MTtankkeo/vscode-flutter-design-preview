{
  "name": "flutter-design-preview",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "mttankkeo",
  "repository": {
    "type": "git",
    "url": "https://github.com/MTtankkeo/vscode-flutter-design-preview.git"
  },
  "icon": "media/icons/flutter.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterWidgetPreview.open",
        "title": "%command.open%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "flutterWidgetPreview.open",
          "when": "resourceFilename == pubspec.yaml",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flutterWidgetPreview",
          "title": "%viewContainer.title%",
          "icon": "media/icons/flutter_preview.svg"
        }
      ]
    },
    "views": {
      "flutterWidgetPreview": [
        {
          "id": "flutterWidgetPreview.view",
          "name": "%viewContainer.title%",
          "icon": "media/icons/flutter_preview.svg",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "format": "prettier \"**/*.{ts,js,json,html,css,md}\" \".github/workflows/**/*.{yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{ts,js,json,html,css,md}\" \".github/workflows/**/*.{yml,yaml}\" --check",
    "publish": "npx.cmd @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.2"
  }
}
